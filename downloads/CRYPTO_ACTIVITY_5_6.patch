+"""Closed-candle crypto scanning, independent of slow cross-market REST jobs.
+
+This changes coverage and latency, not strategy signals or PAPER risk limits.
+History requests use the provider's existing shared budgets and source checks.
+"""
+from collections import deque
+from concurrent.futures import ThreadPoolExecutor
+import threading
+import time
+
+
+class CryptoActivity:
+    INTERVAL = .25
+    MAX_HISTORY_JOBS = 4
+    HISTORY_SPACING_MS = 125
+    SCAN_BATCH = 16
+
+    def __init__(self, supervisor, monotonic=time.monotonic):
+        self.s = supervisor
+        self.monotonic = monotonic
+        self.stop_event = threading.Event()
+        self.thread = None
+        self.pool = ThreadPoolExecutor(max_workers=self.MAX_HISTORY_JOBS, thread_name_prefix='crypto-history')
+        self.jobs = {}
+        self.retry_at = {}
+        self.failures = {}
+        self.processed = {}
+        self.ready = {}
+        self.offset = 0
+        self.history_offset = 0
+        self.next_history_ms = 0
+        self.events = deque()
+        self.lock = threading.Lock()
+        self.stats = {'running': False, 'evaluated_last_minute': 0, 'ready_history': 0,
+                      'fresh_quotes': 0, 'watched': 0, 'history_inflight': 0,
+                      'last_scan_ms': None, 'last_error': None}
+
+    def active(self):
+        return (not self.stop_event.is_set() and not self.s.stop_event.is_set()
+                and self.s.config.get('crypto_scan_mode', 'active') == 'active'
+                and 'crypto' in self.s.config['enabled_markets'])
+
+    @staticmethod
+    def valid_history(bars, symbol, now):
+        # Keep only a real contiguous tail. Never interpolate missing candles.
+        if any(b.market != 'crypto' or b.symbol != symbol or b.interval_ms != 60000 for b in bars):
+            raise ValueError('WRONG_CRYPTO_HISTORY')
+        ordered = sorted({b.start_ms: b for b in bars if b.end_ms <= now}.values(), key=lambda b: b.start_ms)[-300:]
+        for i in range(len(ordered)-1, 0, -1):
+            if ordered[i-1].end_ms != ordered[i].start_ms:
+                ordered = ordered[i:]
+                break
+        return ordered if len(ordered) >= 40 and 0 <= now-ordered[-1].end_ms <= 90000 else []
+
+    def _history(self, symbol, now):
+        bars = self.s.history_cache.get(('crypto', symbol), [])
+        stream = self.s.stream
+        if stream is not None:
+            with stream.lock:
+                received = list(stream.bars.get(symbol, {}).values())
+            bars = [*bars, *received]
+        return self.valid_history(bars, symbol, now)
+
+    def _harvest(self, now):
+        for symbol, future in list(self.jobs.items()):
+            if not future.done():
+                continue
+            self.jobs.pop(symbol)
+            try:
+                bars = self.valid_history(future.result(), symbol, now)
+                if not bars:
+                    self.ready.pop(symbol, None)
+                    raise ValueError('INCOMPLETE_CRYPTO_HISTORY')
+                self.s.history_cache[('crypto', symbol)] = bars
+                self.failures.pop(symbol, None)
+                self.retry_at.pop(symbol, None)
+            except Exception as error:
+                category = getattr(error, 'category', type(error).__name__)
+                failures = self.failures.get(symbol, 0)+1
+                self.failures[symbol] = failures
+                delay = 300000 if category == 'ACCESS_DENIED' else 60000 if category in ('RATE_LIMIT', 'REQUEST_BUDGET') else min(60000, 2000*2**min(5, failures-1))
+                self.retry_at[symbol] = now+delay
+                with self.lock:
+                    self.stats['last_error'] = category
+
+    def pulse(self):
+        now = int(self.s.clock()*1000)
+        self._harvest(now)
+        if not self.active():
+            with self.lock:
+                self.stats['running'] = False
+            return
+        s = self.s
+        with s.journal._lock:
+            symbols = list(s.config['watchlists']['crypto'])
+            quotes = {symbol: s.engine.quotes.get(('crypto', symbol)) for symbol in symbols}
+            rates = dict(s.engine.fx)
+            limits = s.engine.guardian.limits
+            volumes = {symbol: item.get('quote_volume', 0) for symbol, item in s.daily_stats.get('crypto', {}).items()}
+        eligible = []
+        for symbol in symbols:
+            q = quotes[symbol]
+            if q is None:
+                continue
+            try:
+                q.validate(now, max_age=limits.max_quote_age_ms)
+                rates[q.currency].validate(now)
+                if q.bid_size <= 0 or q.ask_size <= 0 or (q.ask/q.bid-1)*10000 > limits.max_spread_bps:
+                    continue
+                eligible.append(symbol)
+            except (ValueError, KeyError):
+                continue
+        # Only inspect the last received start here. Full series are copied when
+        # there is a new closed candle, not on every price tick.
+        stream = s.stream
+        if stream is not None:
+            with stream.lock:
+                stream_ends = {symbol: max(b.end_ms for b in bars.values() if b.end_ms <= now)
+                               for symbol, bars in stream.bars.items() if any(b.end_ms <= now for b in bars.values())}
+        else:
+            stream_ends = {}
+        ready = []
+        cold = []
+        for symbol in eligible:
+            cached = s.history_cache.get(('crypto', symbol), [])
+            end = max(cached[-1].end_ms if cached else 0, stream_ends.get(symbol, 0))
+            if end and 0 <= now-end <= 90000:
+                ready.append((symbol, end))
+            else:
+                cold.append(symbol)
+        # Liquid symbols warm first, but a rotating cursor gives the rest of
+        # the eligible universe a turn instead of rescanning only the majors.
+        cold.sort(key=lambda symbol: -volumes.get(symbol, 0))
+        if cold and len(self.jobs) < self.MAX_HISTORY_JOBS and now >= self.next_history_ms:
+            for i in range(len(cold)):
+                index = (self.history_offset+i) % len(cold)
+                symbol = cold[index]
+                if symbol in self.jobs or now < self.retry_at.get(symbol, 0):
+                    continue
+                self.jobs[symbol] = self.pool.submit(s.providers.candles, 'crypto', symbol)
+                self.history_offset = index+1
+                self.next_history_ms = now+self.HISTORY_SPACING_MS
+                break
+        entries = []
+        started = self.monotonic()
+        evaluated = 0
+        for i in range(len(ready)):
+            index = self.offset % len(ready)
+            self.offset += 1
+            symbol, end = ready[index]
+            if self.processed.get(symbol) == end:
+                continue
+            if not self.active():
+                break
+            try:
+                bars = self._history(symbol, now)
+                if not bars:
+                    self.ready.pop(symbol, None)
+                    # A fresh final bar does not make a gapped/short series ready.
+                    if symbol not in self.jobs and now >= self.retry_at.get(symbol, 0) and len(self.jobs) < self.MAX_HISTORY_JOBS and now >= self.next_history_ms:
+                        self.jobs[symbol] = self.pool.submit(s.providers.candles, 'crypto', symbol)
+                        self.next_history_ms = now+self.HISTORY_SPACING_MS
+                    continue
+                self.ready[symbol] = bars[-1].end_ms
+                outcome = s.process(quotes[symbol], bars, int(s.clock()*1000), defer_entries=True)
+                self.processed[symbol] = bars[-1].end_ms
+                self.events.append((now, symbol))
+                evaluated += 1
+                if isinstance(outcome, dict):
+                    entries.append(outcome)
+            except Exception as error:
+                # No fabricated HOLD or fill when one asset fails. The next
+                # pulse retries it; the journal's immutable IDs prevent repeats.
+                with self.lock:
+                    self.stats['last_error'] = getattr(error, 'category', type(error).__name__)
+            if evaluated >= self.SCAN_BATCH or self.monotonic()-started >= .08:
+                break
+        if self.active():
+            s.execute_ranked_entries(entries)
+        while self.events and self.events[0][0] < now-60000:
+            self.events.popleft()
+        universe = set(symbols)
+        for mapping in (self.processed, self.ready, self.failures, self.retry_at):
+            for symbol in set(mapping)-universe:
+                mapping.pop(symbol, None)
+        with self.lock:
+            self.stats.update(running=True, evaluated_last_minute=len({symbol for _, symbol in self.events}),
+                              ready_history=sum(0 <= now-end <= 90000 for symbol,end in self.ready.items() if symbol in quotes), fresh_quotes=len(eligible), watched=len(symbols),
+                              history_inflight=len(self.jobs), last_scan_ms=now)
+
+    def snapshot(self):
+        with self.lock:
+            return {**self.stats, 'mode': self.s.config.get('crypto_scan_mode', 'active'),
+                    'paper_only': True, 'risk_limits_changed': False}
+
+    def start(self):
+        if self.thread is not None:
+            return
+        def run():
+            while not self.stop_event.is_set() and not self.s.stop_event.is_set():
+                try:
+                    self.pulse()
+                except Exception as error:
+                    with self.lock:
+                        self.stats['last_error'] = getattr(error, 'category', type(error).__name__)
+                        self.stats['running'] = False
+                self.stop_event.wait(self.INTERVAL)
+        self.thread = threading.Thread(target=run, name='crypto-candle-scanner', daemon=True)
+        self.thread.start()
+
+    def close(self):
+        self.stop_event.set()
+        if self.thread is not None:
+            self.thread.join()
+        self.pool.shutdown(wait=True, cancel_futures=True)
