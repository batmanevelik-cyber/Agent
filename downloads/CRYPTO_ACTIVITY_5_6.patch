+        self.s.ingest(qs, {'USDT': FX('USDT', 1, 1, self.now, 'SYNTHETIC')}, now=self.now)
+        if warm:
+            for symbol in symbols:
+                self.s.history_cache[('crypto', symbol)] = candles(NOW, 'crypto', symbol)
+        return symbols
