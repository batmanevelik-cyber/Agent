+    def test_opportunity_outside_legacy_batch_fills_once_with_real_strategy(self):
+        symbols = self.universe(100)
+        limits = asdict(self.s.engine.guardian.limits)
+        original = Strategy.evaluate
+        def evaluate(strategy, bars, **kwargs):
+            if bars[-1].symbol == symbols[-1]:
+                return original(strategy, bars, **kwargs)
+            return Signal('HOLD', 'SYNTHETIC_NO_ENTRY', bars[-1].end_ms, .02, {})
+        with patch.object(Strategy, 'evaluate', evaluate):
+            for _ in range(8):
+                self.worker.pulse()
+            self.assertEqual(self.fills(), [(symbols[-1], 'BUY')])
+            for _ in range(8):
+                self.worker.pulse()
+        self.assertEqual(len(self.fills()), 1)
+        self.assertEqual(self.worker.snapshot()['evaluated_last_minute'], 100)
+        self.assertEqual(self.provider.calls, [])
+        self.assertEqual(asdict(self.s.engine.guardian.limits), limits)
